# Database connection string (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/careeros?sslmode=require

# Google OAuth 2.0 Client ID (Matches frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Mail Settings for 6-Digit OTP Emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-email@gmail.com

# Server Port (Default 8080)
PORT=8080
