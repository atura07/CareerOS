# Database connection string (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/careeros?sslmode=require

# Google OAuth 2.0 Client ID (Matches frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Resend HTTP Email API for 6-Digit OTP Delivery
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=onboarding@resend.dev


# Server Port (Default 8080)
PORT=8080
